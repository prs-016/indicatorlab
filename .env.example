# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# Wikipedia (src/wiki_attention.py): Wikimedia asks every API client for a contact address in its User-Agent
WIKIMEDIA_CONTACT=your-email@example.com

# Reddit pipeline (docs/reddit/README.md)
# LLM sentiment scorer (Claude); only needed for `label_eval` / `score_posts` with the llm scorer
ANTHROPIC_API_KEY=
# Reddit API (PRAW), for future collection of recent posts; create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:indicator-lab-reddit:v1.0 (by /u/your_reddit_username)

# Dashboard API (src/api/): where the processed tables live, and the Vibe-Trading server it proxies.
# Leave INDICATORLAB_DATA empty to read data/ locally; on AWS: s3://indicatorlab-data
INDICATORLAB_DATA=
AWS_REGION=us-west-2
CORS_ORIGINS=http://localhost:5173
VIBE_API_URL=
# Vibe-Trading server key (the API proxies /runs with it; stored in SSM as /indicatorlab/vibe_api_key)
VIBE_API_KEY=
# Local Vibe-Trading checkout; src/wiki_complex.py uses its deflated_sharpe_ratio
VIBE_TRADING_ROOT=

# AWS (infra/README.md): data location for the Reddit pipeline and /reddit routes; leave empty to use local files
INDICATORLAB_BUCKET=indicatorlab-data
INDICATORLAB_DATA_URI=
