# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# Reddit pipeline (docs/reddit/README.md)
# LLM sentiment scorer (Claude); only needed for `label_eval` / `score_posts` with the llm scorer
ANTHROPIC_API_KEY=
# Reddit API (PRAW), for future collection of recent posts; create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:indicator-lab-reddit:v1.0 (by /u/your_reddit_username)

# HK live display: export these in the shell before serving/building.
# The dashboard commands do not automatically load .env.
# Empty browser base uses the same origin. For AWS static hosting use the real HTTPS API URL.
INDICATORLAB_API_BASE_URL=
INDICATORLAB_ATTENTION_ENABLED=false
# API-only configuration; exact origins separated by commas, no wildcard.
INDICATORLAB_CORS_ORIGINS=
INDICATORLAB_LIVE_SOURCE=local
# Leave unset for launcher discovery, or set to a directory containing latest.json.
# INDICATORLAB_LIVE_HK_DIR=/path/to/collector/output
# INDICATORLAB_HSI_ROSTER=/path/to/dated-roster.csv
INDICATORLAB_LIVE_HK_TABLE=indicatorlab-live-hk
AWS_REGION=us-west-2
