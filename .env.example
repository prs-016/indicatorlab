# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# Reddit pipeline (docs/reddit/README.md)
# LLM sentiment scorer (Claude); only needed for `label_eval` / `score_posts` with the llm scorer
ANTHROPIC_API_KEY=
# Reddit API (PRAW), for future collection of recent posts; create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:indicator-lab-reddit:v1.0 (by /u/your_reddit_username)
