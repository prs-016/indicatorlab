+        "regularMarketTime": int((NOW - timedelta(seconds=900)).timestamp()),
+        "currency": "HKD",
+        "regularMarketVolume": 12345,
+    }
+    meta.update(meta_overrides)
+    return {
+        "chart": {
+            "error": None,
+            "result": [
+                {
+                    "meta": meta,
+                    "timestamp": [int((NOW - timedelta(seconds=30)).timestamp())],
+                    "indicators": {"quote": [{"close": [999.0]}]},
+                }
+            ],
